{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".tmp-check",
    "noEmit": false
  },
  "include": ["scripts/**/*.ts", "src/engine/**/*.ts", "src/data/**/*.ts", "src/types.ts"]
}
